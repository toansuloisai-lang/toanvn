GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
MATH_DB_PATH=private/accounts.json
# Local JSON remains available. Render uses MATH_STORAGE=supabase.
MATH_STORAGE=json
# Supabase Connect > Session pooler > PostgreSQL URI (port 5432).
# Replace [YOUR-PASSWORD] with the URL-encoded database password.
SUPABASE_DB_URL=
# Optional PEM root certificate if your project requires it; use literal \n.
SUPABASE_DB_CA=
# Gmail sender: enable 2-step verification, then create a 16-character App Password.
# Never use the normal Gmail password. Configure secrets in Render Environment.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Math Lab
# Render: set secrets in Dashboard > Environment, not in this file.
# INITIAL_ADMIN_PASSWORD is required only for a new empty Render database.
