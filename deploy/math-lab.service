[Unit]
Description=Math Lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mathlab
Group=mathlab
WorkingDirectory=/opt/math-lab
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/math-lab/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
